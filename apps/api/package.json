{
	"name": "@pack-challenge/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Nest API — Resources create + list",
	"scripts": {
		"build": "tsc --noEmit",
		"check-types": "tsc --noEmit",
		"dev": "tsx watch src/main.ts",
		"lint": "tsc --noEmit",
		"start": "tsx src/main.ts",
		"test": "vitest run",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate"
	},
	"dependencies": {
		"@nestjs/common": "^12.4.0",
		"@nestjs/core": "^12.4.0",
		"@nestjs/platform-express": "^12.4.0",
		"@pack-challenge/domain": "workspace:*",
		"drizzle-orm": "^0.45.4",
		"multer": "^2.5.0",
		"postgres": "^4.1.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2"
	},
	"devDependencies": {
		"@nestjs/testing": "^12.4.0",
		"@swc/core": "^1.16.22",
		"@types/express": "^5.0.6",
		"@types/multer": "^2.3.0",
		"@types/node": "^22.20.5",
		"@types/supertest": "^7.2.1",
		"dotenv": "^18.0.9",
		"drizzle-kit": "^0.31.11",
		"supertest": "^7.3.1",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"unplugin-swc": "^2.0.0",
		"vitest": "^4.1.8"
	}
}
