{
  "name": "svelte-file-uploader",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "pnpm audit --audit-level=high",
    "tokens:validate": "pnpm --filter @pack-challenge/tokens validate",
    "tokens:build": "pnpm --filter @pack-challenge/tokens build",
    "tokens:check": "pnpm --filter @pack-challenge/tokens check",
    "storybook": "pnpm --filter @pack-challenge/ui storybook",
    "storybook:build": "pnpm --filter @pack-challenge/ui build-storybook"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "turbo": "^2.11.10"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  }
}
