{
	"name": "@pack-challenge/ui",
	"version": "0.0.0",
	"private": true,
	"keywords": [
		"svelte"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"exports": {
		".": {
			"types": "./src/lib/index.ts",
			"svelte": "./src/lib/index.ts",
			"default": "./src/lib/index.ts"
		}
	},
	"scripts": {
		"dev": "pnpm --filter @pack-challenge/tokens build && vite dev",
		"build": "pnpm --filter @pack-challenge/tokens build && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check-types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "pnpm --filter @pack-challenge/tokens build && prettier --check . && eslint .",
		"format": "pnpm --filter @pack-challenge/tokens build && prettier --write .",
		"test:unit": "vitest run --project server",
		"test": "vitest run --project server --project a11y-specs",
		"test:integration": "vitest run --project integration",
		"test:a11y": "pnpm --filter @pack-challenge/tokens build && vitest run --project a11y",
		"exports:check": "node ./scripts/public-exports.mjs check",
		"exports:write": "node ./scripts/public-exports.mjs write",
		"publish:dry-run": "pnpm publish --dry-run --no-git-checks",
		"storybook": "pnpm --filter @pack-challenge/tokens build && storybook dev -p 6006",
		"build-storybook": "pnpm --filter @pack-challenge/tokens build && storybook build"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"@lucide/svelte": "^0.561.0",
		"@pack-challenge/tokens": "workspace:*",
		"bits-ui": "^2.20.6",
		"svelte-sonner": "^1.2.3"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.0.0",
		"@eslint/js": "^10.0.1",
		"@storybook/addon-a11y": "10.6.5",
		"@storybook/addon-docs": "10.6.5",
		"@storybook/addon-svelte-csf": "^5.0.0",
		"@storybook/addon-vitest": "10.6.5",
		"@storybook/sveltekit": "10.6.5",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^4.1.8",
		"@vitest/coverage-v8": "^4.1.8",
		"axe-core": "^4.14.0",
		"clsx": "^2.1.1",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "10.6.5",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"jsdom": "^31.0.0",
		"playwright": "^1.56.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"storybook": "10.6.5",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.1",
		"tailwindcss": "^4.3.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-axe": "^0.1.0"
	}
}
