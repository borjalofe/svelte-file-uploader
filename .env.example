# Copy to `.env` for local overrides. Never commit real secrets.
# Pack evaluator Compose path: `cp .env.example .env && docker compose up --build`
NODE_ENV=development

# --- Compose service: db (Postgres) ---
# Non-default credentials on purpose — do not use postgres/postgres.
POSTGRES_USER=pack
POSTGRES_PASSWORD=pack_dev_change_me
POSTGRES_DB=pack_challenge
POSTGRES_PORT=5432

# Host-machine URL (apps running on the host with `docker compose up -d db` only).
DATABASE_URL=postgresql://pack:pack_dev_change_me@localhost:5432/pack_challenge

# --- Nest API (apps/api / Compose service `api`) ---
API_PORT=3000
# Absolute or repo-relative directory for uploaded objects (outside web static).
# Compose overrides this to /data/file-store inside the api container.
FILE_STORAGE_ROOT=var/file-store

# --- SvelteKit web (apps/web / Compose service `web`) ---
WEB_PORT=5173
# Nest base URL for *browser* fetches (host localhost, not Docker DNS `api`).
PUBLIC_API_URL=http://localhost:3000
