# Copy to `.env` for local overrides. Never commit real secrets.
# Pack evaluator Compose path: `cp .env.example .env && docker compose up --build`
NODE_ENV=development

# --- Compose service: db (Postgres) ---
# Non-default credentials on purpose — do not use postgres/postgres.
POSTGRES_USER=pack
POSTGRES_PASSWORD=pack_dev_change_me
POSTGRES_DB=pack_challenge
POSTGRES_PORT=5432

# Host-machine URL (apps running on the host with `docker compose up -d db` only).
DATABASE_URL=postgresql://pack:pack_dev_change_me@localhost:5432/pack_challenge

# --- Nest API (apps/api / Compose service `api`) ---
API_PORT=3000
# Absolute or repo-relative directory for uploaded objects (outside web static).
# Compose overrides this to /data/file-store inside the api container.
# Always kept as the local fallback when cloud is unset or unavailable.
FILE_STORAGE_ROOT=var/file-store
# local (default) | s3 — s3 uses AWS S3 / MinIO / R2 compatible APIs.
FILE_STORAGE_DRIVER=local
# Required when FILE_STORAGE_DRIVER=s3 (incomplete → falls back to local).
# S3_BUCKET=
# S3_REGION=eu-west-1
# Optional least-privilege key prefix (no leading slash), e.g. pack-challenge/
# S3_PREFIX=
# Optional custom endpoint (MinIO / LocalStack / R2):
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_FORCE_PATH_STYLE=true
# Credentials via env only — never commit real secrets. Prefer IAM role in prod.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- SvelteKit web (apps/web / Compose service `web`) ---
WEB_PORT=5173
# Nest base URL for *browser* fetches (host localhost, not Docker DNS `api`).
PUBLIC_API_URL=http://localhost:3000
