# Copy to `.env` for local overrides. Never commit real secrets.
NODE_ENV=development

# --- Compose service: db (Postgres) ---
# Non-default credentials on purpose — do not use postgres/postgres.
POSTGRES_USER=pack
POSTGRES_PASSWORD=pack_dev_change_me
POSTGRES_DB=pack_challenge
POSTGRES_PORT=5432

# Host-machine URL (apps running on the host, not inside Compose).
DATABASE_URL=postgresql://pack:pack_dev_change_me@localhost:5432/pack_challenge

# In-compose URL for future `api` service (hostname = service name `db`):
# DATABASE_URL=postgresql://pack:pack_dev_change_me@db:5432/pack_challenge

# --- Reserved Compose services (M12) ---
# api  — Nest API
# web  — SvelteKit web
# API_PORT=3000
# WEB_PORT=5173
# PUBLIC_API_URL=http://localhost:3000
